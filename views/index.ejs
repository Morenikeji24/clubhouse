<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clubhouse</title>
</head>

<body>

  <% if (currentUser) { %>

    <p>Welcome, <%= currentUser.first_name %>!</p>
    <a href="/logout">Log out</a>

    <h2>Messages</h2>

    <% messages.forEach(message => { %>

      <article>
        <h3><%= message.title %></h3>

        <p><%= message.text %></p>

        <p>Posted on: <%= message.time_stamp %></p>

        <% if (currentUser.membership_status || currentUser.admin) { %>

          <p>
            Author:
            <%= message.first_name %>
            <%= message.last_name %>
          </p>

        <% } %>

        <% if (currentUser.admin) { %>

          <form
            action="/messages/<%= message.id %>/delete"
            method="POST"
          >
            <button type="submit">Delete</button>
          </form>

        <% } %>

      </article>

      <hr />

    <% }) %>

  <% } else { %>

    <a href="/login">Log in</a>
    <a href="/sign-up">Sign up</a>

    <p>You must be logged in to view messages.</p>

  <% } %>

</body>

</html>
