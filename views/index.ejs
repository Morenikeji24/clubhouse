
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clubhouse</title>
</head>

<body>

  <% if (currentUser) { %>

    <h1>Welcome, <%= currentUser.first_name %>!</h1>

    <a href="/logout">Log out</a>
    <a href="/messages/new">Create a new message</a>

    <% if (currentUser.admin) { %>

      <p>You are an admin.</p>

    <% } else if (currentUser.membership_status) { %>

      <a href="/become-admin">Become an admin</a>

    <% } else { %>

      <a href="/become-member">Become a member</a>

    <% } %>

  <% } else { %>

    <a href="/login">Log in</a>
    <a href="/sign-up">Sign up</a>

  <% } %>


  <h2>Messages</h2>

  <hr>

  <% if (messages.length === 0) { %>

    <p>No messages yet.</p>

  <% } else { %>

    <% messages.forEach(message => { %>

      <article>

        <h3><%= message.title %></h3>

        <p><%= message.text %></p>

        <% if (currentUser) { %>

          <p>
            Posted on: <%= message.time_stamp %>
          </p>

        <% } %>


        <% if (currentUser && (currentUser.membership_status || currentUser.admin)) { %>

          <p>
            Author:
            <%= message.first_name %>
            <%= message.last_name %>
          </p>

        <% } %>


        <% if (currentUser && currentUser.admin) { %>

          <form
            action="/messages/<%= message.id %>/delete"
            method="POST"
          >
            <button type="submit">Delete</button>
          </form>

        <% } %>

      </article>

      <hr>

    <% }) %>

  <% } %>

</body>

</html>
